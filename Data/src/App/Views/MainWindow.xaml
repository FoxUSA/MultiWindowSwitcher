<ui:FluentWindow
  x:Class="MultiWindowSwitcher.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:controls="clr-namespace:MultiWindowSwitcher.Views.Controls"
  xmlns:core="clr-namespace:MultiWindowSwitcher.Core"
  xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
  Title="MultiWindowSwitcher"
  Width="1200"
  Height="760"
  MinWidth="440"
  MinHeight="320"
  ExtendsContentIntoTitleBar="True"
  Foreground="{DynamicResource TextFillColorPrimaryBrush}"
  Icon="pack://application:,,,/Assets/app.ico"
  ShowActivated="False"
  ShowInTaskbar="False"
  Background="{StaticResource AppBackgroundBrush}"
  WindowBackdropType="None"
  WindowCornerPreference="Round"
  WindowStartupLocation="Manual">

  <!--  рамка подсвечивается, когда мышь в запасной зоне вокруг окна: ещё чуть дальше — и окно уедет  -->
  <Border
    x:Name="EdgeFrame"
    BorderBrush="Transparent"
    BorderThickness="1"
    CornerRadius="8">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <ui:TitleBar
        x:Name="Bar"
        Grid.Row="0"
        Icon="{core:AppIcon}">
        <ui:TitleBar.TrailingContent>
          <StackPanel
            x:Name="BarTrailing"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            Orientation="Horizontal">
            <!--  обновление: «проверка…», потом кнопка, если на byfox.dev есть версия новее  -->
            <ui:Button
              x:Name="UpdateButton"
              Height="28"
              Margin="0,0,12,0"
              Padding="10,0"
              Appearance="Primary"
              Click="OnUpdateClick"
              Icon="{ui:SymbolIcon ArrowDownload24}"
              Visibility="Collapsed" />
            <TextBlock
              x:Name="UpdateStatus"
              Margin="0,0,14,0"
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              Visibility="Collapsed" />
            <ui:ToggleSwitch
              x:Name="DedupSwitch"
              Margin="0,0,14,0"
              Click="OnDedupToggle"
              FontSize="12"
              ToolTip="{core:T DedupTip}">
              <TextBlock x:Name="DedupLabel" Text="{core:T Dedup}" />
            </ui:ToggleSwitch>
            <ui:ToggleSwitch
              x:Name="AutoHideSwitch"
              Margin="0,0,14,0"
              Click="OnAutoHideToggle"
              FontSize="12"
              ToolTip="{core:T AutoHideTip}">
              <TextBlock x:Name="AutoHideLabel" Text="{core:T AutoHide}" />
            </ui:ToggleSwitch>
            <ui:ToggleSwitch
              x:Name="TopmostSwitch"
              Click="OnTopmostToggle"
              FontSize="12"
              ToolTip="{core:T TopmostTip}">
              <TextBlock x:Name="TopmostLabel" Text="{core:T Topmost}" />
            </ui:ToggleSwitch>
            <!--  крестик прячет в трей, «свернуть» — на панель задач, выход — здесь  -->
            <Button
              Margin="14,0,0,0"
              Click="OnExitClick"
              Style="{StaticResource ExitButton}"
              ToolTip="{core:T ExitTip}">
              <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon
                  x:Name="ExitIcon"
                  Margin="0,0,6,0"
                  FontSize="14"
                  Symbol="Power24" />
                <TextBlock x:Name="ExitLabel" VerticalAlignment="Center" Text="{core:T TrayExit}" />
              </StackPanel>
            </Button>
          </StackPanel>
        </ui:TitleBar.TrailingContent>
      </ui:TitleBar>

      <!--  панель: поиск, фильтр, монитор, пропорции, группировка  -->
      <Grid x:Name="Toolbar" Grid.Row="1" Margin="12,2,12,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ui:TextBox
          x:Name="SearchBox"
          Grid.Column="0"
          Width="80"
          Height="34"
          Margin="0,0,8,0"
          Icon="{ui:SymbolIcon Search24}"
          PlaceholderText="{core:T Search}"
          TextChanged="OnSearchChanged" />

        <Border
          Grid.Column="1"
          Height="34"
          Margin="0,0,8,0"
          Padding="2"
          Background="{DynamicResource ControlFillColorDefaultBrush}"
          BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="5">
          <StackPanel Orientation="Horizontal">
            <RadioButton
              x:Name="FilterAll"
              Checked="OnFilterChanged"
              GroupName="Filter"
              IsChecked="True"
              Style="{StaticResource SegmentButton}">
              <TextBlock>
                <Run Text="{core:T FilterAll}" /> <Run x:Name="CountAll" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </TextBlock>
            </RadioButton>
            <!--  «Скрытые» видны, только когда есть скрытые окна  -->
            <RadioButton
              x:Name="FilterHidden"
              Checked="OnFilterChanged"
              GroupName="Filter"
              Visibility="Collapsed"
              Style="{StaticResource SegmentButton}"
              ToolTip="{core:T FilterHiddenTip}">
              <TextBlock>
                <Run Text="{core:T FilterHidden}" /> <Run x:Name="CountHidden" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
              </TextBlock>
            </RadioButton>
          </StackPanel>
        </Border>

        <ComboBox
          x:Name="MonitorBox"
          Grid.Column="2"
          MinWidth="150"
          Height="34"
          Padding="10,0"
          VerticalContentAlignment="Center"
          SelectionChanged="OnMonitorChanged" />

        <TextBlock
          Grid.Column="4"
          Margin="8,0,8,0"
          Visibility="Collapsed"
          VerticalAlignment="Center"
          FontSize="12"
          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
          Text="{core:T Aspect}" />
        <ComboBox
          x:Name="AspectBox"
          Grid.Column="5"
          Visibility="Collapsed"
          Width="92"
          Height="34"
          Margin="0,0,8,0"
          Padding="10,0"
          VerticalContentAlignment="Center"
          SelectionChanged="OnAspectChanged">
          <ComboBoxItem Content="16:10" Tag="1.6" />
          <ComboBoxItem Content="16:9" Tag="1.777" />
          <ComboBoxItem Content="4:3" Tag="1.333" />
          <ComboBoxItem Content="1:1" Tag="1" />
        </ComboBox>

        <StackPanel Grid.Column="6" Orientation="Horizontal">
          <!--  активные углы — под рукой, а не в настройках  -->
          <ui:Button
            x:Name="CornersButton"
            Height="34"
            Margin="0,0,8,0"
            Padding="11,0"
            Click="OnCornersClick"
            ToolTip="{core:T CornersButtonTip}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="ArrowExpand24" />
              <TextBlock x:Name="CornersLabel" Margin="6,0,0,0" VerticalAlignment="Center" Text="{core:T CornersButton}" />
              <ui:SymbolIcon
                Margin="6,0,0,0"
                FontSize="12"
                Symbol="ChevronDown24" />
            </StackPanel>
          </ui:Button>
          <ui:Button
            x:Name="BigTitlesButton"
            Height="34"
            Margin="0,0,8,0"
            Padding="11,0"
            Click="OnTitlesClick"
            ToolTip="{core:T TitlesButtonTip}">
            <StackPanel Orientation="Horizontal">
              <ui:SymbolIcon Symbol="TextFont24" />
              <TextBlock x:Name="TitlesLabel" Margin="6,0,0,0" VerticalAlignment="Center" Text="{core:T BigTitles}" />
              <ui:SymbolIcon
                Margin="6,0,0,0"
                FontSize="12"
                Symbol="ChevronDown24" />
            </StackPanel>
          </ui:Button>
        </StackPanel>
        <ui:Button
          x:Name="GroupButton"
          Grid.Column="7"
          Height="34"
          Margin="0,0,8,0"
          Padding="11,0"
          Click="OnGroup"
          ToolTip="{core:T GroupTip}">
          <StackPanel Orientation="Horizontal">
            <ui:SymbolIcon Symbol="Group24" />
            <TextBlock x:Name="GroupLabel" Margin="6,0,0,0" VerticalAlignment="Center" Text="{core:T Group}" />
          </StackPanel>
        </ui:Button>
        <ui:Button
          Grid.Column="8"
          Width="34"
          Height="34"
          Margin="0,0,8,0"
          Padding="0"
          Click="OnRefresh"
          Icon="{ui:SymbolIcon ArrowClockwise24}"
          ToolTip="{core:T RefreshTip}" />
        <ui:Button
          x:Name="SettingsButton"
          Grid.Column="9"
          Width="34"
          Height="34"
          Padding="0"
          Click="OnSettingsClick"
          Icon="{ui:SymbolIcon Settings24}"
          ToolTip="{core:T SettingsTip}" />
      </Grid>

      <!--  сетка окон  -->
      <Grid Grid.Row="2" Margin="12,0,12,0">
        <controls:TileLayoutPanel x:Name="Tiles" />
        <TextBlock
          x:Name="EmptyText"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          FontSize="14"
          Foreground="{DynamicResource TextFillColorTertiaryBrush}"
          Text="{core:T Empty}"
          Visibility="Collapsed" />
      </Grid>

      <!--  строка состояния: сколько окон, сетка, последнее действие, подсказки для мыши  -->
      <Border
        Grid.Row="3"
        Height="30"
        Margin="0,10,0,0"
        Padding="14,0"
        Background="#1F000000"
        BorderBrush="#2B2B2B"
        BorderThickness="0,1,0,0"
        CornerRadius="0,0,8,8">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal">
            <Ellipse
              Width="7"
              Height="7"
              Margin="0,0,7,0"
              VerticalAlignment="Center"
              Fill="#6CCB5F" />
            <TextBlock
              x:Name="StatusText"
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            <TextBlock
              x:Name="GridText"
              Margin="16,0,0,0"
              VerticalAlignment="Center"
              FontSize="12"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
          </StackPanel>
          <TextBlock
            x:Name="ToastText"
            Grid.Column="1"
            Margin="16,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="12"
            Foreground="{StaticResource BrandBrush}"
            TextTrimming="CharacterEllipsis" />
          <TextBlock
            x:Name="HintsText"
            Grid.Column="2"
            VerticalAlignment="Center"
            FontSize="11.5"
            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Grid>
      </Border>

      <!--  настройки: всплывают поверх превью (отдельное окно Popup — превью DWM его не перекрывает)  -->
      <Popup
        x:Name="SettingsPopup"
        AllowsTransparency="True"
        Placement="Bottom"
        PlacementTarget="{Binding ElementName=SettingsButton}"
        PopupAnimation="Fade"
        StaysOpen="False">
        <Border
          Width="1040"
          Margin="0,6,0,0"
          Background="{StaticResource PopupBrush}"
          BorderBrush="{StaticResource PopupStrokeBrush}"
          BorderThickness="1"
          CornerRadius="8">
          <!--  прокрутка — только если окно совсем маленькое  -->
          <ScrollViewer MaxHeight="900" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="SettingsHost" Margin="14,14,14,2" />
          </ScrollViewer>
        </Border>
      </Popup>

      <!--  активные углы: схема экрана, клик по углу — вкл/выкл  -->
      <Popup
        x:Name="CornersPopup"
        AllowsTransparency="True"
        Placement="Bottom"
        PlacementTarget="{Binding ElementName=CornersButton}"
        PopupAnimation="Fade"
        StaysOpen="False">
        <Border
          Width="300"
          Margin="0,6,0,0"
          Padding="14,12,14,14"
          Background="{StaticResource PopupBrush}"
          BorderBrush="{StaticResource PopupStrokeBrush}"
          BorderThickness="1"
          CornerRadius="8">
          <StackPanel x:Name="CornersHost" />
        </Border>
      </Popup>

      <!--  крупные названия: включить, размер, цвет  -->
      <Popup
        x:Name="TitlesPopup"
        AllowsTransparency="True"
        Placement="Bottom"
        PlacementTarget="{Binding ElementName=BigTitlesButton}"
        PopupAnimation="Fade"
        StaysOpen="False">
        <Border
          Width="320"
          Margin="0,6,0,0"
          Padding="14,12,14,14"
          Background="{StaticResource PopupBrush}"
          BorderBrush="{StaticResource PopupStrokeBrush}"
          BorderThickness="1"
          CornerRadius="8">
          <!--  три раздела: что в названии, крупные названия, значки — у каждого свой заголовок  -->
          <StackPanel>
            <StackPanel.Resources>
              <Style x:Key="ViewSection" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                <Setter Property="Margin" Value="0,0,0,8" />
              </Style>
              <Style x:Key="ViewTip" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Margin" Value="0,2,0,10" />
              </Style>
              <Style x:Key="ViewDivider" TargetType="Border">
                <Setter Property="Margin" Value="-14,4,-14,12" />
                <Setter Property="BorderBrush" Value="{StaticResource PopupStrokeBrush}" />
                <Setter Property="BorderThickness" Value="0,1,0,0" />
              </Style>
            </StackPanel.Resources>

            <!--  1. что показывать в названии  -->
            <TextBlock Style="{StaticResource ViewSection}" Text="{core:T ViewSecText}" />
            <Border
              Height="32"
              Padding="2"
              HorizontalAlignment="Left"
              Background="{DynamicResource ControlFillColorDefaultBrush}"
              BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
              BorderThickness="1"
              CornerRadius="5">
              <StackPanel Orientation="Horizontal">
                <RadioButton
                  x:Name="PartFull"
                  Checked="OnTitlePartChanged"
                  Content="{core:T PartFull}"
                  GroupName="TitlePart"
                  Style="{StaticResource SegmentButton}" />
                <RadioButton
                  x:Name="PartWindow"
                  Checked="OnTitlePartChanged"
                  Content="{core:T PartWindow}"
                  GroupName="TitlePart"
                  Style="{StaticResource SegmentButton}" />
                <RadioButton
                  x:Name="PartApp"
                  Checked="OnTitlePartChanged"
                  Content="{core:T PartApp}"
                  GroupName="TitlePart"
                  Style="{StaticResource SegmentButton}" />
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource ViewTip}" Text="{core:T PartTip}" />
            <!--  «Google Chrome - Панель» вместо «Панель - Google Chrome»: только когда видно всё  -->
            <ui:ToggleSwitch
              x:Name="AppFirstSwitch"
              Click="OnAppFirstSwitch"
              Content="{core:T AppFirst}" />
            <TextBlock Style="{StaticResource ViewTip}" Text="{core:T AppFirstTip}" />

            <!--  2. крупные названия  -->
            <Border Style="{StaticResource ViewDivider}" />
            <TextBlock Style="{StaticResource ViewSection}" Text="{core:T ViewSecBig}" />
            <ui:ToggleSwitch
              x:Name="BigTitlesSwitch"
              Click="OnBigTitlesSwitch"
              Content="{core:T BigTitlesAll}" />
            <TextBlock Style="{StaticResource ViewTip}" Text="{core:T BigTitlesTip}" />
            <Grid Margin="0,0,0,2">
              <TextBlock FontSize="12" Text="{core:T TitleSize}" />
              <TextBlock
                x:Name="TitleSizeText"
                HorizontalAlignment="Right"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
            <Slider
              x:Name="TitleSizeSlider"
              Margin="0,0,0,10"
              IsSnapToTickEnabled="True"
              Maximum="200"
              Minimum="50"
              TickFrequency="10"
              ValueChanged="OnTitleSizeChanged" />
            <TextBlock
              Margin="0,0,0,6"
              FontSize="12"
              Text="{core:T TitleColor}" />
            <WrapPanel x:Name="TitleColors" Margin="0,0,0,4" />

            <!--  какие окна: и спрятанные в трей  -->
            <Border Style="{StaticResource ViewDivider}" />
            <TextBlock Style="{StaticResource ViewSection}" Text="{core:T ViewSecWindows}" />
            <ui:ToggleSwitch
              x:Name="TrayWindowsSwitch"
              Click="OnTrayWindowsSwitch"
              Content="{core:T TrayWindows}" />
            <TextBlock Style="{StaticResource ViewTip}" Text="{core:T TrayWindowsTip}" />
            <ui:ToggleSwitch
              x:Name="TraySnapshotsSwitch"
              Click="OnTraySnapshotsSwitch"
              Content="{core:T TraySnapshots}" />
            <TextBlock Style="{StaticResource ViewTip}" Text="{core:T TraySnapshotsTip}" />

            <!--  3. крупный значок программы в левом нижнем углу превью: за него глаз цепляется при поиске окна  -->
            <Border Style="{StaticResource ViewDivider}" />
            <TextBlock Style="{StaticResource ViewSection}" Text="{core:T ViewSecIcons}" />
            <ui:ToggleSwitch
              x:Name="BigIconsSwitch"
              Click="OnBigIconsSwitch"
              Content="{core:T BigIcons}" />
            <TextBlock Style="{StaticResource ViewTip}" Text="{core:T BigIconsTip}" />
            <Grid Margin="0,0,0,2">
              <TextBlock FontSize="12" Text="{core:T IconSize}" />
              <TextBlock
                x:Name="IconSizeText"
                HorizontalAlignment="Right"
                FontSize="12"
                Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
            </Grid>
            <Slider
              x:Name="IconSizeSlider"
              IsSnapToTickEnabled="True"
              Maximum="192"
              Minimum="32"
              TickFrequency="8"
              ValueChanged="OnIconSizeChanged" />
          </StackPanel>
        </Border>
      </Popup>

      <!--  своё имя окна и правило, по которому его узнавать после перезапуска  -->
      <Popup
        x:Name="RenamePopup"
        AllowsTransparency="True"
        Placement="Relative"
        PopupAnimation="Fade"
        StaysOpen="False">
        <Border
          Padding="10"
          Background="{StaticResource PopupBrush}"
          BorderBrush="{StaticResource PopupStrokeBrush}"
          BorderThickness="1"
          CornerRadius="8">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ui:TextBox
                x:Name="NameBox"
                Grid.Column="0"
                FontSize="15"
                FontWeight="SemiBold"
                KeyDown="OnRenameKey"
                MaxLength="40"
                PlaceholderText="{core:T NamePlaceholder}" />
              <ui:Button
                Grid.Column="1"
                Margin="6,0,0,0"
                Appearance="Primary"
                Click="OnRenameOk"
                Content="OK" />
            </Grid>
            <TextBlock
              x:Name="RuleText"
              Margin="2,8,0,4"
              FontSize="11.5"
              Foreground="{DynamicResource TextFillColorTertiaryBrush}"
              TextWrapping="Wrap" />
            <ui:TextBox
              x:Name="FragmentBox"
              FontSize="12"
              KeyDown="OnRenameKey"
              MaxLength="60" />
          </StackPanel>
        </Border>
      </Popup>
    </Grid>
  </Border>
</ui:FluentWindow>
